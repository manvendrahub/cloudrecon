# ============================================================
#  CloudRecon – environment variables for EC2 deployment
#  Copy this file to .env, fill in real values, keep it secret.
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=cloudrecon
DB_USER=cloudrecon
DB_PASSWORD=change_me_db_password

# ── JWT (must be ≥ 32 chars) ────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_32chars_minimum_here

# ── CORS (your EC2 public IP or domain) ─────────────────────
# Separate multiple origins with commas, no trailing slash.
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP,https://YOUR_DOMAIN.com

# ── Gemini (optional – leave blank for OpenCV/LaMa fallback) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# ── AI service tuning ────────────────────────────────────────
# Maximum image side (px) fed to LaMa. Lower = less VRAM / RAM.
AI_MAX_SIDE=1024
